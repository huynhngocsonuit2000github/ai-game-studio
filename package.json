{
  "name": "ai-game-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter @studio/portal dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project portal/tsconfig.json",
    "test": "vitest run && node --test scripts/tests/*.test.mjs",
    "build": "pnpm --filter @studio/portal build",
    "test:browser": "pnpm build && playwright test",
    "assemble:pages": "node scripts/assemble-pages.mjs",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "~8.3.8",
    "vitest": "^5.1.2"
  }
}
